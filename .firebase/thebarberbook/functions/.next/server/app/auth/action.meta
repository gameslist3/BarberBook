{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/auth/layout,_N_T_/auth/action/layout,_N_T_/auth/action/page,_N_T_/auth/action"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/auth/action/__PAGE__",
    "/auth/action",
    "/auth",
    "/_index",
    "/_head"
  ]
}